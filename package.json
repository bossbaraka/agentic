{
  "name": "whatsapp-ai-agent",
  "version": "1.0.0",
  "private": true,
  "description": "بوت واتساب تفاعلي يعمل بـ Gemini عبر WhatsApp Cloud API الرسمي",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/demo/simulate.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "test": "tsx scripts/test-flow.ts",
    "prestart": "node -e \"import('fs').then(fs => fs.mkdirSync('data',{recursive:true}))\""
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@google/genai": "^2.21.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "openai": "^7.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.0"
  }
}
