# ══════════════════════════════════════════════════════════════
#  إعدادات بوت واتساب الذكي
#  انسخ هذا الملف إلى .env وعدّل القيم:   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ────────── وضع التشغيل ──────────
# true = تجربة كاملة بدون واتساب ولا مفاتيح (يرد بمحرك وهمي)
# ابدأ هنا أول مرة:
DEMO_MODE=true
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ────────── Gemini (الدماغ) ──────────
# مفتاح مجاني من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# الموديل: gemini-2.5-flash (رخيص وسريع) أو gemini-3.5-flash (أذكى وأغلى)
GEMINI_MODEL=gemini-2.5-flash
# عنوان بديل للـ API — للاختبار مع خادم محاكٍ أو وسيط (اتركه فارغًا عادةً)
GEMINI_BASE_URL=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024
# 0 = أسرع وأرخص (مناسب لواتساب) | -1 = النموذج يقرر
GEMINI_THINKING_BUDGET=0
GEMINI_JSON_MODE=true
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRIES=2

# ────────── شخصية البوت ──────────
# business = خدمة عملاء فقط | assistant = مساعد شخصي | hybrid = الاثنين (الموصى به)
BOT_MODE=hybrid
BOT_NAME=سارة
BUSINESS_NAME=متجر النخبة
DEFAULT_LANGUAGE=ar

# أقصى عدد رسائل في الرد الواحد، وطول الرسالة
MAX_REPLY_PARTS=3
MAX_SEGMENT_CHARS=900

# كم رسالة سابقة تُرسل للنموذج كسياق
HISTORY_TURNS=24
# دقيقة خمول بعدها تُعتبر المحادثة جديدة (يُحتفظ بالملخص)
SESSION_TTL_MINUTES=45
# حد رسائل العميل في الدقيقة (حماية من الإساءة)
RATE_LIMIT_PER_MIN=15
# تفعيل الأدوات (حجز / حالة طلب / تذكرة / كتيّب)
TOOLS_ENABLED=true
IGNORE_FORWARDED=false

# ────────── WhatsApp Cloud API (موقوف حالياً - لتفعيله ضع true) ──────────
WHATSAPP_ENABLED=false
# من: https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# من: إعدادات التطبيق → Basic → App Secret  (مطلوب للتحقق من التوقيع)
WHATSAPP_APP_SECRET=
# كلمة سر تختارها أنت وتضعها نفسها في Meta عند تسجيل الـ webhook
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token-2026
GRAPH_API_VERSION=v23.0

# ────────── Telegram Bot API ──────────
# من: Telegram → @BotFather
TELEGRAM_BOT_TOKEN=
# نمط التشغيل: polling (الموصى به محليًا بدون ngrok) | webhook | disabled
TELEGRAM_MODE=polling
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# سلوك تفاعلي
TYPING_INDICATOR=true
# إيموجي يوضع على رسالة العميل فور وصولها (اتركه فارغًا للتعطيل) — مثال: 👀 أو ✅
AUTO_REACTION=
# رقم الموظف البشري ومسؤول المواعيد الذي يستقبل تنبيهات التحويل والحجز
HUMAN_AGENT_ID=+97059349809
# رقم واتساب مدير المنصة — كل طلب مؤكد يُحوَّل إليه فورًا
WHATSAPP_MANAGER_NUMBER=97059349809
# رقم تيليجرام المدير
TELEGRAM_MANAGER_PHONE=+972599891559

# ────────── لوحة التحكم ──────────
WEBHOOK_PATH=/webhook
DASHBOARD_PATH=/admin
# ⚠️ اضبط كلمة مرور قوية قبل النشر على الإنترنت
DASHBOARD_PASSWORD=
# تفعيل نقطة الاختبار /internal/simulate خارج وضع التجربة
INTERNAL_TEST_HOOK=false

# ────────── التخزين ──────────
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
MEDIA_DIR=./data/media
SAVE_MEDIA=true
MAX_MEDIA_BYTES=8388608
