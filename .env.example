# ══════════════════════════════════════════════════════════════
#  إعدادات بوت واتساب الذكي
#  انسخ هذا الملف إلى .env وعدّل القيم:   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ────────── وضع التشغيل ──────────
# true = تجربة كاملة بدون واتساب ولا مفاتيح (يرد بمحرك وهمي)
# ابدأ هنا أول مرة:
DEMO_MODE=true
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ────────── محرك الذكاء الاصطناعي (LLM) ──────────
# openai = محرك OpenAI (GPT-4o) | gemini = محرك Google Gemini
LLM_PROVIDER=openai

# ────────── OpenAI (الدماغ الرئيسي والاحترافي) ──────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ────────── Gemini (محرك بديل/احتياطي) ──────────
# مفتاح مجاني من: https://aistudio.google.com/apikey
# 💡 عدة مفاتيح = تحويل تلقائي عند انتهاء الحصة: KEY1,KEY2,KEY3
GEMINI_API_KEY=

# الموديل الرئيسي (يُستخدم كما هو — لا يعدّله الكود)
GEMINI_MODEL=gemini-2.5-flash
# عنوان بديل للـ API — للاختبار مع خادم محاكٍ أو وسيط (اتركه فارغًا عادةً)
GEMINI_BASE_URL=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# بدائل تلقائية تُجرَّب بالترتيب عند تعذّر الرئيسي (404/حصة) — العميل لا يشعر بشيء
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
# ⚠️ موديلات 1.5 و2.0 توقفت من Google نهائيًا (ترجع 404) — لا تستخدمها
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=1024
# 0 = أسرع وأرخص (مناسب لواتساب) | -1 = النموذج يقرر
GEMINI_THINKING_BUDGET=0
GEMINI_JSON_MODE=true
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRIES=2

# ────────── شخصية البوت ──────────
# business = خدمة عملاء فقط | assistant = مساعد شخصي | hybrid = الاثنين
# منصة مُريح: business (بيع + تفعيل اشتراكات + دعم مشتركين)
BOT_MODE=business
BOT_NAME=بوت مُريح
BUSINESS_NAME=منصة مُريح للخدمات الإلكترونية
DEFAULT_LANGUAGE=ar

# أقصى عدد أجزاء في الرد، وطول كل رسالة — يسمح بردود غنية وتفاعلية بدون إغراق
MAX_REPLY_PARTS=4
MAX_SEGMENT_CHARS=1200

# كم رسالة سابقة تُرسل للنموذج كسياق (مع ملخص دائم للمحادثات الطويلة)
HISTORY_TURNS=36
# دقيقة خمول بعدها تُعتبر المحادثة جديدة (يُحتفظ بالملخص)
SESSION_TTL_MINUTES=45
# حد رسائل العميل في الدقيقة (حماية من الإساءة)
RATE_LIMIT_PER_MIN=15
# تفعيل الأدوات (تفاصيل باقة / توصية / تسجيل تفعيل / تذكرة دعم)
TOOLS_ENABLED=true
IGNORE_FORWARDED=false

# ────────── تيليجرام ──────────
# توكن البوت من @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# رابط عام نهائي (https) لو تريد وضع webhook بدل الاستطلاع الدوري (فارغ = استطلاع)
TELEGRAM_WEBHOOK_URL=
# سر تحقق إضافي في webhook (اختياري)
TELEGRAM_WEBHOOK_SECRET=
# معرف الدردشة الإدارية لتنبيهات التحويل/الليدات (اختياري)
TELEGRAM_HUMAN_CHAT_ID=
# معرف دردشة المدير الذي يستقبل إشعارات طلبات الشراء والإطلاق المؤكدة
TELEGRAM_MANAGER_CHAT_ID=

# ────────── WhatsApp Cloud API ──────────
# false = إيقاف الخدمة مؤقتًا (لا webhook ولا إرسال)
WHATSAPP_ENABLED=true
# من: https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# من: إعدادات التطبيق → Basic → App Secret  (مطلوب للتحقق من التوقيع)
WHATSAPP_APP_SECRET=
# كلمة سر تختارها أنت وتضعها نفسها في Meta عند تسجيل الـ webhook
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token-2026
GRAPH_API_VERSION=v23.0

# سلوك تفاعلي
TYPING_INDICATOR=true
# إيموجي يوضع على رسالة العميل فور وصولها (اتركه فارغًا للتعطيل) — مثال: 👀 أو ✅
AUTO_REACTION=
# رقم الموظف البشري (wa_id) الذي يستقبل تنبيهات التحويل
HUMAN_AGENT_ID=
# رقم مدير المنصة (واتساب، أرقام فقط) — تُرسل إليه طلبات الإطلاق المؤكدة كاملةً فور تأكيد العميل
WHATSAPP_MANAGER_NUMBER=970593498909

# ────────── لوحة التحكم ──────────
WEBHOOK_PATH=/webhook
DASHBOARD_PATH=/admin
# ⚠️ اضبط كلمة مرور قوية قبل النشر على الإنترنت
DASHBOARD_PASSWORD=
# تفعيل نقطة الاختبار /internal/simulate خارج وضع التجربة
INTERNAL_TEST_HOOK=false

# ────────── استضافة Render ومنع السبات (Keep-Alive) ──────────
# Render يمرر رابطه العام تلقائيًا في RENDER_EXTERNAL_URL
# لمنع خمول باقة Render المجانية بعد 15 دقيقة:
RENDER_EXTERNAL_URL=
KEEP_ALIVE_URL=
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=10

# ────────── التخزين ──────────
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
MEDIA_DIR=./data/media
SAVE_MEDIA=true
MAX_MEDIA_BYTES=8388608
